<odoo>

    <!-- Extend the official loan form view to add OCA-specific fields and buttons -->
    <record id="account_loan_form_oca" model="ir.ui.view">
        <field name="name">account.loan.form.oca</field>
        <field name="model">account.loan</field>
        <field name="inherit_id" ref="account_loans.account_loan_form_view" />
        <field name="arch" type="xml">
            <!-- Add OCA buttons in header -->
            <button name="action_confirm" position="before">
                <button
                    name="oca_compute_lines"
                    type="object"
                    string="Compute items"
                    invisible="loan_type == False"
                />
                <button
                    name="%(account_loan_post_action)d"
                    invisible="state != 'draft' or loan_type == False"
                    class="oe_highlight"
                    type="action"
                    string="Post (OCA)"
                    groups="account.group_account_manager"
                />
            </button>
            <!-- Add Reset to Draft button -->
            <button name="action_set_to_draft" position="after">
                <button
                    name="oca_button_draft"
                    invisible="state not in ('running', 'cancelled') or nb_posted_entries != 0 or loan_type == False"
                    type="object"
                    string="Reset to draft (OCA)"
                    groups="account.group_account_manager"
                />
            </button>
            <!-- Add OCA stat buttons in button_box -->
            <div class="oe_button_box" name="button_box" position="inside">
                <button
                    name="oca_view_account_moves"
                    class="oe_stat_button"
                    icon="fa-bars"
                    invisible="state == 'draft' or loan_type == False"
                    type="object"
                >
                    <field
                        string="OCA Moves"
                        name="oca_move_count"
                        widget="statinfo"
                    />
                </button>
                <button
                    name="oca_view_account_invoices"
                    class="oe_stat_button"
                    icon="fa-pencil-square-o"
                    invisible="state == 'draft' or not is_leasing"
                    type="object"
                    string="Invoices"
                />
                <button
                    name="%(account_loan_pay_amount_action)d"
                    class="oe_stat_button"
                    icon="fa-arrow-down"
                    invisible="state != 'running' or loan_type == False"
                    type="action"
                    groups="account.group_account_manager"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Deduct</span>
                        <span class="o_stat_text">Debt</span>
                    </div>
                </button>
                <button
                    name="%(account_loan_increase_amount_act_window)d"
                    class="oe_stat_button"
                    icon="fa-arrow-up"
                    invisible="state != 'running' or loan_type == False"
                    type="action"
                    groups="account.group_account_manager"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Increase</span>
                        <span class="o_stat_text">Debt</span>
                    </div>
                </button>
            </div>
            <!-- Add OCA fields in the loan settings page -->
            <group name="loan_settings_column1" position="before">
                <group string="OCA Loan Settings" name="oca_settings_1">
                    <field name="partner_id" />
                    <field name="loan_type" />
                    <field name="rate_type" />
                    <field name="rate" />
                    <field name="rate_period" />
                    <field name="method_period" />
                </group>
                <group string="OCA Options" name="oca_settings_2">
                    <field name="is_leasing" />
                    <field name="round_on_end" />
                    <field name="payment_on_first_period" />
                    <field name="journal_type" invisible="1" />
                </group>
            </group>
            <!-- Add OCA summary fields -->
            <notebook position="before">
                <group invisible="state == 'draft' or loan_type == False">
                    <group>
                        <field name="oca_pending_principal_amount" />
                        <field name="oca_payment_amount" />
                        <field name="oca_interests_amount" />
                    </group>
                </group>
            </notebook>
            <!-- Add Leasing page to notebook -->
            <page name="main_page" position="after">
                <page
                    string="Leasing"
                    id="oca_leasing"
                    invisible="not is_leasing"
                >
                    <group>
                        <group>
                            <field
                                name="leased_asset_account_id"
                                required="is_leasing"
                            />
                            <field name="residual_amount" />
                        </group>
                        <group>
                            <field name="product_id" required="is_leasing" />
                            <field
                                name="interests_product_id"
                                required="is_leasing"
                            />
                            <field name="post_invoice" />
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <!-- Extend official list view to add OCA fields -->
    <record id="account_loan_list_oca" model="ir.ui.view">
        <field name="name">account.loan.list.oca</field>
        <field name="model">account.loan</field>
        <field name="inherit_id" ref="account_loans.account_loan_list_view" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="partner_id" optional="hide" />
                <field name="is_leasing" optional="hide" />
                <field name="loan_type" optional="hide" />
            </field>
            <field name="expense_account_id" position="after">
                <field name="rate" optional="hide" />
                <field name="oca_pending_principal_amount" optional="hide" sum="Total" />
            </field>
        </field>
    </record>

    <!-- Extend official search view -->
    <record id="account_loan_search_oca" model="ir.ui.view">
        <field name="name">account.loan.search.oca</field>
        <field name="model">account.loan</field>
        <field name="inherit_id" ref="account_loans.account_loan_search_view" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="partner_id" />
            </field>
        </field>
    </record>

</odoo>
