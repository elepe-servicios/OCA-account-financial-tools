<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Extend the official loan line list view to add OCA fields -->
    <record id="account_loan_line_list_oca" model="ir.ui.view">
        <field name="name">account.loan.line.list.oca</field>
        <field name="model">account.loan.line</field>
        <field name="inherit_id" ref="account_loans.account_loan_line_list_view" />
        <field name="arch" type="xml">
            <field name="outstanding_balance" position="after">
                <field name="oca_rate" optional="hide" />
                <field name="oca_pending_principal_amount" optional="hide" />
                <field
                    name="oca_long_term_pending_principal_amount"
                    optional="hide"
                />
                <field
                    name="oca_long_term_principal_amount"
                    optional="hide"
                />
                <field name="oca_has_moves" column_invisible="True" />
                <field name="oca_has_invoices" column_invisible="True" />
                <field name="oca_is_leasing" column_invisible="True" />
                <field name="loan_state" column_invisible="True" />
                <button
                    name="oca_view_account_values"
                    string="Values"
                    type="object"
                    icon="fa-eye"
                    invisible="not oca_has_moves and not oca_has_invoices"
                />
                <button
                    name="oca_view_process_values"
                    string="Process"
                    type="object"
                    icon="fa-cogs"
                    invisible="oca_has_moves or oca_has_invoices or loan_state != 'running'"
                />
            </field>
        </field>
    </record>

    <!-- Extend official loan line search view -->
    <record id="account_loan_line_search_oca" model="ir.ui.view">
        <field name="name">account.loan.line.search.oca</field>
        <field name="model">account.loan.line</field>
        <field name="inherit_id" ref="account_loans.account_loan_line_search_view" />
        <field name="arch" type="xml">
            <field name="loan_name" position="after">
                <field name="oca_partner_id" />
            </field>
        </field>
    </record>

</odoo>
